module(
    name = "pico",
    version = "0.9.1",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "googletest", version = "1.18.0")
bazel_dep(name = "openmp", version = "21.1.5.bcr.3")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "hedron_compile_commands", version = "0.0.2-pseudo", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "7fe1eab26d2b8eeb5e1c6a2f38bddb001e3f9696",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

# Import http_archive for fetching external source libraries outside BCR
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Fetch Apple Metal-CPP header-only library with an inline overlay BUILD target
http_archive(
    name = "metal_cpp",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "metal_cpp",
    hdrs = glob(["**/*.hpp"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "0433df1e0ab13c2b0becbd78665071e3fa28381e9714a3fce28a497892b8a184",
    strip_prefix = "metal-cpp",
    urls = ["https://developer.apple.com/metal/cpp/files/metal-cpp_macOS15_iOS18.zip"],
)